# Copy to .env and fill in for local runs. Never commit the real .env.

# Telegram bot token from @BotFather (use a separate test bot for local runs).
TELEGRAM_BOT_TOKEN=

# Chat id where the bot posts Job results (new Plans, regenerated Темы, ready
# Статьи). Send the bot a message and check https://api.telegram.org/bot<token>/getUpdates
# to find your chat id.
TELEGRAM_NOTIFY_CHAT_ID=

# Postgres connection string, e.g. postgresql://user:password@localhost:5432/content_zavod
# Local runs only: under docker compose it is built from the three POSTGRES_* below.
POSTGRES_DSN=

# docker compose (VPS): the Postgres container is created with these, and bot/worker connect
# with them. Pick a long random password of letters and digits only (it goes into a URL),
# e.g. `openssl rand -hex 24`. Changing it later does not change an existing database.
POSTGRES_USER=content_zavod
POSTGRES_PASSWORD=
POSTGRES_DB=content_zavod

# Yandex Cloud folder id (shared by YandexGPT, YandexART, Wordstat, web search).
YANDEX_FOLDER_ID=

# Exactly one of the two below:
# - a service-account API key (no expiry)
YANDEX_API_KEY=
# - a long-lived OAuth token (refreshed internally into short-lived IAM tokens)
YANDEX_OAUTH_TOKEN=

# IANA timezone used for the weekly plan schedule and week labels. Default: Europe/Moscow
APP_TIMEZONE=Europe/Moscow

# Optional per-step cost accounting (#74). Left unset, every generation step's cost
# stays explicitly unknown (never a silent 0.0) instead of guessing a price.
YANDEX_TEXT_COST_PER_1K_TOKENS=
YANDEX_IMAGE_COST_PER_GENERATION=
# One Yandex Search API web search request (research makes one per Тема, #94).
YANDEX_SEARCH_COST_PER_REQUEST=

# Research for every Тема searches the web via Yandex Search API (same folder and key;
# the service account needs the web search role). `off` = no search: Статьи are written
# without facts/numbers and carry a note for the editor. Default: on
YANDEX_WEB_SEARCH=on

# Optional (#92): telegra.ph access token for the «📖 Читать» pages of ready Статьи.
# Left unset, the bot creates a Telegraph account on first use and stores its token in the DB.
TELEGRAPH_ACCESS_TOKEN=
