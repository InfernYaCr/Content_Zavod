# Copy to .env and fill in for local runs. Never commit the real .env.

# Telegram bot token from @BotFather (use a separate test bot for local runs).
TELEGRAM_BOT_TOKEN=

# Глобальные администраторы: Telegram ids, comma-separated (may stay empty). Not a role inside
# a Пространство - every user who presses /start gets their own; these ids also see /admin.
# Your own id: ask @userinfobot, or check https://api.telegram.org/bot<token>/getUpdates.
GLOBAL_ADMIN_TELEGRAM_IDS=

# Postgres connection string, e.g. postgresql://user:password@localhost:5432/content_zavod
# Local runs only: under docker compose it is built from the three POSTGRES_* below.
POSTGRES_DSN=

# docker compose (VPS): the Postgres container is created with these, and bot/worker connect
# with them. Pick a long random password of letters and digits only (it goes into a URL),
# e.g. `openssl rand -hex 24`. Changing it later does not change an existing database.
POSTGRES_USER=content_zavod
POSTGRES_PASSWORD=
POSTGRES_DB=content_zavod

# Yandex Cloud folder id (shared by YandexGPT, Alice AI ART, Wordstat, web search).
YANDEX_FOLDER_ID=

# Service account roles (on the folder): ai.languageModels.user (YandexGPT),
# ai.imageGeneration.user (covers, only with YANDEX_COVERS=on), search-api.webSearch.user
# (web search and Wordstat). Or ai.editor in place of the two ai.* roles.
# Exactly one of the two below:
# - a service-account API key (no expiry). Scopes: yc.ai.languageModels.execute,
#   yc.ai.imageGeneration.execute (covers), yc.search-api.execute (web search and Wordstat).
YANDEX_API_KEY=
# - a long-lived OAuth token (refreshed internally into short-lived IAM tokens)
YANDEX_OAUTH_TOKEN=

# IANA timezone a new Пространство starts with (each owner can change theirs on the Расписание
# screen). Default: Europe/Moscow
APP_TIMEZONE=Europe/Moscow

# Model names inside the folder's model URI (gpt://<folder>/<name>, art://<folder>/<name>).
# Explicit names, not aliases like `yandexgpt`: an alias answers 400 once its model's support
# ends. List: https://aistudio.yandex.ru/docs/ru/ai-studio/concepts/generation/models
# Default text model: yandexgpt-5.1 (YandexGPT Pro 5.1). Default image model: aliceai-image-art-3.0
YANDEX_TEXT_MODEL=
YANDEX_IMAGE_MODEL=

# Covers for every Тема (Alice AI ART via the Images API). `off` = no covers: nothing is
# generated, and the Хаб and the Статья card show no cover. Default: off
YANDEX_COVERS=off

# Optional per-step cost accounting (#74). Left unset, every generation step's cost
# stays explicitly unknown (never a silent 0.0) instead of guessing a price.
# Prices with VAT as of 12.10.2026 (https://aistudio.yandex.ru/docs/ru/ai-studio/pricing,
# https://aistudio.yandex.ru/docs/ru/search-api/pricing):
# YandexGPT Pro 5.1, synchronous: 0.8 ₽ per 1000 tokens (input and output alike).
YANDEX_TEXT_COST_PER_1K_TOKENS=
# One image generation request: 2.23 ₽.
YANDEX_IMAGE_COST_PER_GENERATION=
# One Yandex Search API web search request (research makes one per Тема, #94):
# synchronous, 0.488 ₽ by day, 0.366 ₽ at night (00:00-08:00 Moscow time).
YANDEX_SEARCH_COST_PER_REQUEST=

# Research for every Тема searches the web via Yandex Search API (same folder and key;
# the service account needs the web search role). `off` = no search: Статьи are written
# without facts/numbers and carry a note for the editor. Default: on
YANDEX_WEB_SEARCH=on

# Optional (#92): telegra.ph access token for the «📖 Читать» pages of ready Статьи.
# Left unset, the bot creates a Telegraph account on first use and stores its token in the DB.
TELEGRAPH_ACCESS_TOKEN=
